# Copy to .env — never commit the real one.

# ---------- AI ----------
# AI Pipe token here; leave BASE_URL empty for real OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://aipipe.org/openai/v1
OPENAI_MODEL=gpt-4.1-mini
MAX_INTERVIEW_QUESTIONS=6

# ---------- Supabase (leave all empty = local dev: in-memory, no login) ----------
# Project Settings -> API / Data API
SUPABASE_URL=
# The publishable / anon key. Public by design — only used by scripts/login.py.
SUPABASE_ANON_KEY=
# Connect -> Session pooler connection string, with your database password filled in
DATABASE_URL=
# Only if your project uses the LEGACY JWT secret (Settings -> JWT). New projects: leave empty.
SUPABASE_JWT_SECRET=
# NEVER put the service_role / secret key here — the backend doesn't need it.

# Course sync tool (python -m sync) sends pages here: your Render URL, or http://localhost:8000
PLANLY_API_URL=http://localhost:8000
# Optional: exact YouTube lengths (Google Cloud Console -> YouTube Data API v3 -> API key)
YOUTUBE_API_KEY=
