# Copy to .env.local (never commit it).
# The FastAPI backend.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Same project as backend/.env. The anon/publishable key is public by design.
# Leave both empty to run without login (matches backend dev mode).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
